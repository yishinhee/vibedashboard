# ============================================================
# harness-dashboard — 환경변수 템플릿
# 사용법: cp .env.example .env  → 각 값 채우기
# 실제 .env 는 절대 커밋하지 않는다.
# ============================================================

# ------------------------------------------------------------
# Django Core
# ------------------------------------------------------------
# SECRET_KEY 생성: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=replace-with-random-50-char-string
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_SETTINGS_MODULE=config.settings.dev

# ------------------------------------------------------------
# Database
# ------------------------------------------------------------
DATABASE_URL=sqlite:///db.sqlite3

# ------------------------------------------------------------
# Synology Chat Bot
# (운영 채널 정보는 .env.global 또는 운영자에게 문의)
# ------------------------------------------------------------
SYNOLOGY_BASE_URL=https://your.synology.host:5001
SYNOLOGY_BOT_TOKEN=
SYNOLOGY_BOT_USER_ID=
SYNOLOGY_CHANNEL_ID=

# ------------------------------------------------------------
# Telegram Bot (선택)
# 봇 생성: https://t.me/BotFather
# Chat ID 확인: https://t.me/userinfobot
# ------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ------------------------------------------------------------
# GitHub Personal Access Token
# 발급: https://github.com/settings/tokens (권한: repo, workflow)
# ------------------------------------------------------------
GITHUB_PAT=
