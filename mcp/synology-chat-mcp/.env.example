# Synology NAS 주소 (포트 포함)
# DSM 7 기준 기본 HTTPS 포트: 5001
SYNOLOGY_BASE_URL=https://your-nas-ip:5001

# Synology Chat → 통합 → Bot → 토큰
SYNOLOGY_BOT_TOKEN=your_bot_token_here

# Outgoing Webhook 수신 포트 (이 서버가 열어두는 포트)
# Synology Chat Bot 설정의 Outgoing Webhook URL:
#   http://your-server-ip:8765/webhook
WEBHOOK_PORT=8765
